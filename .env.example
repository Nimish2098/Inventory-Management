# Database Configuration
POSTGRES_DB=inventory
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/inventory
SPRING_DATASOURCE_USERNAME=postgres_user
SPRING_DATASOURCE_PASSWORD=replace_with_strong_database_password

# Application Security
# Generate a 32-byte Base64 key:
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Linux/macOS: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_32_BYTE_SECRET

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com

# Discord Webhook Notification URL (Optional, leave blank if not sending notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# External Monitoring Allowlist (Comma-separated exact hostnames)
EXTERNAL_MONITOR_ALLOWED_HOSTS=store1.example.com,store2.example.com

# Monitoring Scheduling Intervals (in milliseconds)
MONITOR_INVENTORY_INTERVAL_MS=300000
EXTERNAL_MONITOR_INTERVAL_MS=900000
NOTIFICATION_DELIVERY_INTERVAL_MS=10000

# Rate Limiting (Requests per minute for auth endpoints)
AUTH_RATE_LIMIT_PER_MINUTE=30
